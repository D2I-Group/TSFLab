{
  "$id": "https://diaugeia.ai/schema/round_spec.schema.json",
  "additionalProperties": false,
  "description": "One evaluation round of a real-time track.",
  "properties": {
    "channels": {
      "description": "Channel (series / node) ids, in column order.",
      "items": {
        "type": "string"
      },
      "title": "Channels",
      "type": "array"
    },
    "cutoff": {
      "description": "Last observed timestamp (ISO 8601).",
      "title": "Cutoff",
      "type": "string"
    },
    "data_version": {
      "description": "Dataset release the round was opened from.",
      "title": "Data Version",
      "type": "string"
    },
    "deadline": {
      "description": "Submissions after this instant are rejected.",
      "title": "Deadline",
      "type": "string"
    },
    "freq": {
      "description": "Pandas frequency string of the panel, e.g. 'h' or 'B'.",
      "title": "Freq",
      "type": "string"
    },
    "hf_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pinned hub revision of that release.",
      "title": "Hf Revision"
    },
    "mode": {
      "default": "time_series",
      "enum": [
        "time_series",
        "spatiotemporal",
        "covariate"
      ],
      "title": "Mode",
      "type": "string"
    },
    "norm_mean": {
      "description": "Per-channel mean frozen at the cutoff.",
      "items": {
        "type": "number"
      },
      "title": "Norm Mean",
      "type": "array"
    },
    "norm_std": {
      "description": "Per-channel std frozen at the cutoff.",
      "items": {
        "type": "number"
      },
      "title": "Norm Std",
      "type": "array"
    },
    "opened_at": {
      "description": "When the round was opened (ISO 8601).",
      "title": "Opened At",
      "type": "string"
    },
    "round_id": {
      "description": "Round id, e.g. '2026-W40'.",
      "title": "Round Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seq_len": {
      "description": "Reference input length for catalog baselines.",
      "minimum": 1,
      "title": "Seq Len",
      "type": "integer"
    },
    "target_timestamps": {
      "description": "Timestamps to forecast, in order.",
      "items": {
        "type": "string"
      },
      "title": "Target Timestamps",
      "type": "array"
    },
    "track": {
      "description": "Real-time track id, e.g. 'traffic_pems_sb'.",
      "title": "Track",
      "type": "string"
    }
  },
  "required": [
    "track",
    "round_id",
    "data_version",
    "freq",
    "cutoff",
    "target_timestamps",
    "channels",
    "seq_len",
    "opened_at",
    "deadline",
    "norm_mean",
    "norm_std"
  ],
  "title": "RoundSpec",
  "type": "object",
  "x-tsf-schema-version": "1.1.0"
}
