{
  "$id": "https://diaugeia.ai/schema/round_score.schema.json",
  "additionalProperties": false,
  "description": "Score of one submission once the round's truth is available.",
  "properties": {
    "coverage": {
      "description": "Fraction of target cells that were observed.",
      "maximum": 1,
      "minimum": 0,
      "title": "Coverage",
      "type": "number"
    },
    "mae": {
      "title": "Mae",
      "type": "number"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "mse": {
      "description": "MSE on channels z-scored with the round's frozen statistics.",
      "title": "Mse",
      "type": "number"
    },
    "rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank"
    },
    "round_id": {
      "title": "Round Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submitter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitter"
    },
    "track": {
      "title": "Track",
      "type": "string"
    }
  },
  "required": [
    "track",
    "round_id",
    "model",
    "mse",
    "mae",
    "coverage"
  ],
  "title": "RoundScore",
  "type": "object",
  "x-tsf-schema-version": "1.1.0"
}
